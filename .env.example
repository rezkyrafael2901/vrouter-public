# VRouter Public — environment variables
# Copy to .env and fill real values. NEVER commit real secrets.

# Database
PUB_DB_PATH=public.db

# Upstream router
VROUTER_URL=http://127.0.0.1:20129
VROUTER_KEY=your_internal_bearer_token

# SMTP (email sending)
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Server
PUB_PORT=20130
SITE_NAME=VRouter
SITE_TAGLINE=One API. Every model.
SITE_URL=https://vrouter.my.id

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
